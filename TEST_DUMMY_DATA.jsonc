  "_meta": {
    "purpose": "Dummy test data for manual UI/API testing across major modules without changing app code.",
    "usage_order": [
      "1. Create company setup records first",
      "2. Create units, categories, warehouses, accounts, expense categories",
      "3. Create customers, suppliers, employees",
      "4. Create products",
      "5. Create inventory opening stock and batches",
      "6. Create purchase and sales transactions",
      "7. Create payments, expenses, accounting, GST and payroll entries"
    ],
    "notes": [
      "All IDs below are sample UUIDs so you can use this file for API payload testing too.",
      "If a UI select field auto-generates IDs from database, use the matching name/code from this file instead of the UUID.",
      "Dates are kept in the past so validation should pass.",
      "GST, PAN, IFSC, mobile, pincode and password formats follow project validation rules."
    ]
  },

