PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_access_secret
JWT_REFRESH_SECRET=replace_with_at_least_32_characters_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=1d
COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME=Advanced Accounting Software
EMAIL_FROM_ADDRESS=noreply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=SMTP_USERNAME
SMTP_PASS=SMTP_PASSWORD
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HASH_SECRET=replace_with_at_least_32_characters_otp_secret
INVITE_EXPIRY_HOURS=48
PASSWORD_RESET_EXPIRY_MINUTES=15
INVENTORY_EXPIRY_ALERT_DAYS=30
DB_POOL_MIN=1
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_SSL_MODE=auto
DB_SSL_REJECT_UNAUTHORIZED=false
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2
EXPENSE_UPLOAD_DIR=uploads/expenses
EXPENSE_MAX_UPLOAD_MB=5
EXPENSE_MAX_ATTACHMENTS=5
PUBLIC_UPLOAD_BASE_URL=/uploads
